# Copy to .env.local and fill in. Never commit .env.local.
#
# The app runs on a partial config: every provider client reports itself
# "unconfigured" rather than throwing, so you can develop against sandbox
# behaviour with only the first two sections filled in.

# ── Required ──────────────────────────────────────────────────────────────
# Neon Postgres. Tables are created automatically on first run.
DATABASE_URL=

# Clerk. Also covers Base / Coinbase Wallet sign-in, which is enabled in the
# Clerk dashboard and needs no additional keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public base URL. Used to build provider callback and redirect URLs, so it
# must be your real deployment URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk routing (optional; sensible defaults) ───────────────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Card issuing ──────────────────────────────────────────────────────────
# Two issuers are supported. Which is primary is a runtime setting in the
# admin console, not a deploy-time constant. Configure either, or both.

# Flutterwave — v4 sandbox pair, or set FLW_SECRET_KEY alone for the v3 API.
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
# FLW_SECRET_KEY=
# Shared secret Flutterwave sends in the `verif-hash` webhook header.
FLW_SECRET_HASH=
FLW_CARD_WEBHOOK_URL=

# Stripe — one key drives both Issuing and hosted Checkout.
STRIPE_SECRET_KEY=
# Cardholder billing address, only used when Stripe Issuing mints a card.
STRIPE_BILLING_LINE1=
STRIPE_BILLING_CITY=
STRIPE_BILLING_STATE=
STRIPE_BILLING_POSTAL=
STRIPE_BILLING_COUNTRY=

# ── Deposits: M-Pesa (Safaricom Daraja STK push) ──────────────────────────
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be publicly reachable over https.
MPESA_CALLBACK_URL=
# Optional shared secret appended to the callback URL as ?secret=
MPESA_CALLBACK_SECRET=

# ── Deposits: crypto (USDC on Base) ───────────────────────────────────────
# Signing key for the on-chain indexer webhook, used to verify HMAC-SHA256 over
# the raw body. NOT a value you choose: copy it from the provider's webhook
# detail page (Alchemy shows it as "signing key"). Required for crypto deposits
# to credit — the webhook rejects every request without it.
CRYPTO_WEBHOOK_SECRET=
CRYPTO_MIN_CONFIRMATIONS=3
# Coinbase OnchainKit, for the in-app wallet connect UI only.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────
# Fallback used only if the live USD->KES feed is unreachable.
FX_FALLBACK_KES_PER_USD=129
# Extra admin emails, comma separated.
ADMIN_EMAILS=

# ── Identity verification: Dojah (KYC) ────────────────────────────────────
# Kenyan National ID database match, gating card issuance. Server-side only —
# the secret key and AppId must never reach the browser bundle.
# Sandbox is https://sandbox.dojah.io; production is https://api.dojah.io.
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Signing secret for the x-dojah-signature webhook header. Defaults to
# DOJAH_SECRET_KEY when unset, which matches Dojah's default behaviour.
DOJAH_WEBHOOK_SECRET=
# Compare the PII Dojah echoes back, not just its is_*_match flags. Defaults to
# on except against sandbox, whose fixed persona always reports a match.
# DOJAH_STRICT_MATCH=true

# ── Per-user USDC deposit addresses (Base) ────────────────────────────────
# BIP-39 mnemonic that every user's deposit address is derived from
# (m/44'/60'/0'/0/{user id}). CUSTODY: whoever holds this controls every
# user's deposits — keep it in a secret manager, never in the repo.
# Generate one with:  node -e "console.log(require('viem/accounts').generateMnemonic(require('viem/accounts').english))"
DEPOSIT_MASTER_MNEMONIC=
# 8453 = Base mainnet, 84532 = Base Sepolia.
DEPOSIT_CHAIN_ID=8453
# Defaults to canonical USDC on Base mainnet. Override on a testnet.
# DEPOSIT_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ── Chain listener (Alchemy Notify address-activity webhook) ──────────────
# Optional. Without it, deposit addresses are still issued and still receive
# funds — nothing credits them automatically. Create an Address Activity
# webhook pointing at /api/webhooks/crypto, then set both values so newly
# provisioned addresses are added to it automatically.
ALCHEMY_NOTIFY_TOKEN=
ALCHEMY_WEBHOOK_ID=
